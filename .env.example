# Runtime
NODE_ENV=production
SCHOLARK_RELEASE=r136
# Keep global test mode on while SCHOLARK is still testing media/research/payments.
SCHOLARK_TEST_MODE=1

# Core text AI routing. When enabled, Studio + Learning use Gemini even while global test mode stays on.
SCHOLARK_AI_LIVE=1
SCHOLARK_AI_PROVIDER=gemini

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# AI providers — server-side only. Never put these keys in client-side JS.
POLLINATIONS_API_KEY=sk_REPLACE_ME
OPENAI_API_KEY=sk_REPLACE_ME
GEMINI_API_KEY=REPLACE_ME

# Model routing
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.8-flash
# Automatic same-provider failover for temporary overloads/rate limits.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
POLLINATIONS_MODEL=gpt-5.6-sol
POLLINATIONS_FAST_MODEL=openai-fast
POLLINATIONS_BALANCED_MODEL=gpt-5.6-terra
POLLINATIONS_PREMIUM_MODEL=gpt-5.6-sol
POLLINATIONS_FALLBACK_MODEL=gpt-5.6-terra
POLLINATIONS_LEARNING_MODEL=gpt-5.6-terra
POLLINATIONS_TRANSLATION_MODEL=openai-fast
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_RESEARCH_MODEL=perplexity-fast
OPENAI_STUDIO_MODEL=gpt-5.6-terra
OPENAI_LEARNING_MODEL=gpt-5.6-luna
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_BALANCED_MODEL=gpt-5.6-terra
OPENAI_PREMIUM_MODEL=gpt-5.6-sol

# Paddle is intentionally not filled here until sandbox/live IDs and credentials are available.
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PLUS_PRICE_ID=
PADDLE_PRO_PRICE_ID=